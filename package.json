{
  "name": "saltyfactory",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter \"./apps/storefront\" --filter \"./apps/studio\" --filter \"./apps/worker\" dev",
    "dev:storefront": "corepack pnpm --filter \"./apps/storefront\" dev",
    "dev:studio": "corepack pnpm --filter \"./apps/studio\" dev",
    "dev:worker": "corepack pnpm --filter \"./apps/worker\" dev",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json --pretty false",
    "test": "vitest run",
    "build": "corepack pnpm -r --if-present build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "frontend:auth-setup": "tsx scripts/create-studio-e2e-storage-state.ts",
    "frontend:qa": "playwright test",
    "frontend:qa:image-mockup": "tsx scripts/run-image-mockup-browser-proof.ts",
    "frontend:qa:auth": "tsx scripts/run-studio-authenticated-qa.ts",
    "frontend:qa:report": "playwright show-report",
    "check:frontend-contrast": "tsx scripts/check-frontend-contrast.ts",
    "db:generate": "corepack pnpm --filter @saltyfactory/db db:generate",
    "db:migrate": "corepack pnpm --filter @saltyfactory/db db:migrate",
    "db:apply-local": "corepack pnpm --filter @saltyfactory/db db:apply-local",
    "db:push:guarded": "corepack pnpm --filter @saltyfactory/db db:push:guarded",
    "db:health": "corepack pnpm --filter @saltyfactory/db db:health",
    "db:seed:dev": "corepack pnpm --filter @saltyfactory/db db:seed:dev",
    "db:seed:production-minimal": "corepack pnpm --filter @saltyfactory/db db:seed:production-minimal",
    "seed:studio-owner": "tsx scripts/seed-studio-owner.ts",
    "tsx": "tsx",
    "worker:run": "corepack pnpm --filter @saltyfactory/worker worker:run",
    "worker:run-once": "corepack pnpm --filter @saltyfactory/worker worker:run-once",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:guardrails": "tsx scripts/check-guardrails.ts",
    "check:production": "tsx scripts/check-production.ts",
    "check:ai-factory-standard": "tsx scripts/check-ai-factory-standard.ts",
    "smoke:image-mockup-live": "tsx scripts/smoke-image-mockup-live.ts",
    "smoke:printify-mockups-live": "tsx scripts/smoke-printify-mockups-live.ts",
    "smoke:ollama-agent-local": "tsx scripts/smoke-ollama-agent-local.ts",
    "smoke:trend-sources": "tsx scripts/smoke-trend-sources.ts",
    "smoke:marketing-launch-planning": "tsx scripts/smoke-marketing-launch-planning.ts",
    "smoke:shop-manager-agent-os": "tsx scripts/smoke-shop-manager-agent-os.ts",
    "smoke:agent-deterministic-core": "tsx scripts/smoke-agent-deterministic-core.ts",
    "smoke:local-folder-image-import": "tsx scripts/smoke-local-folder-image-import.ts"
  },
  "dependencies": {
    "@auth/core": "latest",
    "@saltyfactory/integrations": "workspace:*",
    "@saltyfactory/security": "workspace:*",
    "@saltyfactory/site-audit": "workspace:*",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "latest",
    "blockhash-core": "latest",
    "drizzle-kit": "latest",
    "drizzle-orm": "latest",
    "next": "latest",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/nextjs": "^10.4.6",
    "@tailwindcss/oxide-wasm32-wasi": "^4.3.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
