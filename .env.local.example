# Local SaltyFactory development configuration.
# Copy to .env.local for local development only. Do not put real secrets in this example.

# Core
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_STOREFRONT_BASE_URL=http://localhost:3000
STUDIO_WORKSPACE_ID=wks_default
STUDIO_DATA_DIAGNOSTICS=false

# Supabase / Database
# Use REPOSITORY_ADAPTER=memory for UI-only local fixtures. Use DATABASE_URL for persisted local data.
REPOSITORY_ADAPTER=memory
DATABASE_URL=
DIRECT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Guided Setup Concierge can accept owner-entered provider tokens only when encrypted credential storage is enabled.
# Keep false locally unless you provide a 32+ character development-only encryption key.
CREDENTIAL_STORAGE_ENABLED=false
CREDENTIAL_ENCRYPTION_KEY=
SUPABASE_PRIVATE_ASSETS_BUCKET=saltyfactory-private-assets
SUPABASE_PUBLIC_ASSETS_BUCKET=saltyfactory-public-assets
SUPABASE_STORAGE_BUCKET=saltyfactory-private-assets

# Studio Auth
# Real login requires Supabase Auth config. Authenticated browser QA uses a dedicated test account.
STUDIO_AUTH_ENABLED=true
STUDIO_ADMIN_EMAIL=
AUTH_SECRET=

# Authenticated Playwright QA
# Use a dedicated Supabase Auth test user that is linked to the local Studio workspace.
# Never use Jennie's personal browser session or commit the generated storage-state file.
STUDIO_E2E_EMAIL=
STUDIO_E2E_PASSWORD=
STUDIO_E2E_BASE_URL=http://localhost:3001
STUDIO_E2E_STORAGE_STATE=test-results/studio-auth-state.json
STUDIO_E2E_SCREENSHOTS=true

# Image Generation
# Provider-backed generation requires HuggingFace-compatible token/model and private storage.
AI_TEXT_ENABLED=false
AI_IMAGE_ENABLED=false
HF_API_TOKEN=
HF_TEXT_MODEL=
HF_IMAGE_MODEL=
HUGGING_FACE_API_TOKEN=
HUGGING_FACE_IMAGE_MODEL=
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_PROVIDER=disabled
LOCAL_DEV_IMAGE_GENERATION=false
IMAGE_GENERATION_TIMEOUT_MS=60000
IMAGE_GENERATION_MAX_OUTPUT_BYTES=15000000
BACKGROUND_REMOVAL_ENABLED=false
UPSCALE_ENABLED=false
HF_REMBG_MODEL=
HF_ESRGAN_MODEL=
REPLICATE_API_TOKEN=
REMOVE_BG_API_KEY=

# Worker
# Worker generation uses the repository adapter, image provider config, and private storage above.

# Printify
PRINTIFY_ENABLED=false
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_ALLOW_PUBLISH=false

# Shopify
SHOPIFY_STOREFRONT_ENABLED=false
SHOPIFY_ADMIN_ENABLED=false
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CREDENTIAL_MODE=legacy_admin_token
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_DEFAULT_COLLECTION_ID=
SHOPIFY_ALLOW_PRODUCT_PUBLISH=false

# AI Employees / Model Runtime
# Internal AI employee desks work without external model providers. Provider calls require the AI/HF flags above.

# Business Command Center
# Internal business records work with REPOSITORY_ADAPTER=memory locally or DATABASE_URL for persistence.

# Business Identity / Documents
# EIN and bank-sensitive values must never be stored in plaintext env vars.

# Banking / Novo / Plaid
# Novo direct API is not verified or used in v1. Plaid sync is read-only and owner-consented when implemented.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
BANKING_LIVE_SYNC_ENABLED=false
BANKING_MONEY_MOVEMENT_ENABLED=false

# Google / Discovery Integrations
GA4_ENABLED=false
GOOGLE_ANALYTICS_ENABLED=false
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GSC_ENABLED=false
GOOGLE_SEARCH_CONSOLE_ENABLED=false
GSC_SITE_URL=
GBP_ENABLED=false
GOOGLE_BUSINESS_PROFILE_ENABLED=false
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
GOOGLE_INTEGRATIONS_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/studio/integrations/google/oauth/callback

# Safety Flags
LIVE_PUBLISHING_ENABLED=false
EXTERNAL_ORDER_SUBMISSION_ENABLED=false
WEBHOOK_SECRET_SHOPIFY=
WEBHOOK_SECRET_PRINTIFY=

# Local Development / Fixtures
# To test local fixture image generation, explicitly set:
# IMAGE_GENERATION_ENABLED=true
# IMAGE_GENERATION_PROVIDER=local_dev_mock
# LOCAL_DEV_IMAGE_GENERATION=true
# This is blocked in production and is labeled as a local dev fixture in API responses.
